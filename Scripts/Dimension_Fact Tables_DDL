
/*

creating the dimension tables and fact table

dimension table -- we have descriptive data, non aggregate data

fact table -- we have measures and reference column of dimension tables

*/

--First Create the DimDate  dimension table 
create table dim_date 
( 
    Date_id int identity(1,1) primary key, 
    full_date date , 
    year int, 
    month int, 
    month_name varchar(15), 
    quarter int, 
    week int, 
    day int 
) 

--create the dimlocation table 
 
create table dim_location 
( 
    location_id int identity(1,1) primary key, 
    state varchar(50), 
    city varchar(100), 
    location varchar(100) 
)

--create the dim restaurant table 
 
create table dim_restaurant 
( 
    restaurant_id int identity(1,1) primary key, 
    restaurant_name varchar(100) 
)

--create the dim category table 
 
create table dim_category 
( 
    category_id int identity(1,1) primary key, 
    category_name varchar(100)  
) 

--create the dim dish table 
create table dim_dish 
( 
 
    dish_id int identity(1,1) primary key, 
    dish_name varchar(200) 
 
)

--Now create the fact table 
create table Fact_swiggy_orders 
( 
 
    --fact columns  
    order_id int identity(1,1) primary key, 
    price_inr decimal(10,2), 
    rating decimal(10,2), 
    rating_count int,    
 
    --reference columns creation 
 
    date_id int, 
    location_id int, 
    restuarant_id int, 
    category_id int, 
    dish_id int, 
 
    --relation creation btw dim and fact table 
 
    foreign key(date_id) references dim_date(date_id), 
    foreign key(location_id) references dim_location (location_id), 
    foreign key(restuarant_id) references dim_restaurant(restaurant_id), 
    foreign key(category_id) references dim_category(category_id), 
    foreign key(dish_id) references dim_dish(dish_id) 
)


